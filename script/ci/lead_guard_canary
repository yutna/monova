#!/usr/bin/env ruby
# frozen_string_literal: true

# Canary for the Claude lead's PreToolUse hook (protocol §3 and §10).
# Each case feeds the hook the JSON Claude Code would send and checks the
# exit code: 2 blocks the tool call, 0 allows it.

require "fileutils"
require "json"
require "open3"
require "shellwords"
require "tmpdir"

root = File.expand_path("../..", __dir__)
hook = File.join(root, ".claude", "hooks", "lead_guard")
abort "lead_guard_canary: #{hook} is missing or not executable; checked 0" unless File.executable?(hook)

Case = Struct.new(:name, :tool, :input, :env, :expected, keyword_init: true)

def payload(tool, input)
  JSON.generate("tool_name" => tool, "tool_input" => input)
end

def file_tool(name, tool, path, expected, env: {})
  Case.new(name: name, tool: tool, input: { "file_path" => path }, env: env, expected: expected)
end

def notebook(name, path, expected, env: {})
  Case.new(name: name, tool: "NotebookEdit", input: { "notebook_path" => path }, env: env, expected: expected)
end

def bash(name, command, expected)
  Case.new(name: name, tool: "Bash", input: { "command" => command }, env: {}, expected: expected)
end

WIRING_TOOLS = %w[Edit Write MultiEdit NotebookEdit Bash].freeze

def matcher_covers?(matcher, tool)
  return true if matcher.nil? || matcher.empty? || matcher == "*"
  return true if matcher.split("|").map(&:strip).include?(tool)

  # Anchored, so "Edit" does not stand in for "MultiEdit" or "NotebookEdit".
  Regexp.new("\\A(?:#{matcher})\\z").match?(tool)
rescue RegexpError
  false
end

# True when a hook command runs lead_guard itself: the script path alone,
# optionally written against the project directory variable. A command that
# only names the path, such as `echo` or `cat`, does not run it.
def lead_guard_command?(command, root)
  words = Shellwords.split(command.to_s)
  return false unless words.length == 1

  token = words.first.sub(/\A\$(?:\{CLAUDE_PROJECT_DIR\}|CLAUDE_PROJECT_DIR)\//) { "#{root}/" }
  File.expand_path(token, root) == File.join(root, ".claude", "hooks", "lead_guard")
rescue ArgumentError
  false
end

# Replaces the command of every hook that runs lead_guard.
def with_lead_guard_command(data, root, command)
  Array(data.dig("hooks", "PreToolUse")).each do |entry|
    next unless entry.is_a?(Hash)

    Array(entry["hooks"]).each do |hook|
      next unless hook.is_a?(Hash) && hook["type"] == "command"
      next unless lead_guard_command?(hook["command"], root)

      hook["command"] = command
    end
  end
  data
end

# Returns the reasons .claude/settings.json does not register lead_guard,
# or an empty array when it does.
def wiring_errors(settings_path, root)
  return [ "#{settings_path} is missing" ] unless File.file?(settings_path)

  data = begin
    JSON.parse(File.read(settings_path))
  rescue JSON::ParserError => error
    return [ "#{settings_path} is not valid JSON: #{error.message}" ]
  end

  if data.is_a?(Hash) && data["disableAllHooks"] == true
    return [ "disableAllHooks is true, so Claude Code runs no hooks" ]
  end

  hooks = data.is_a?(Hash) ? data["hooks"] : nil
  entries = hooks.is_a?(Hash) ? Array(hooks["PreToolUse"]) : []
  matchers = entries.filter_map do |entry|
    next unless entry.is_a?(Hash)

    commands = Array(entry["hooks"]).select do |hook|
      hook.is_a?(Hash) && hook["type"] == "command" &&
        lead_guard_command?(hook["command"], root)
    end
    entry["matcher"] unless commands.empty?
  end

  return [ "no PreToolUse command hook runs .claude/hooks/lead_guard" ] if matchers.empty?

  WIRING_TOOLS.filter_map do |tool|
    "lead_guard matcher does not cover #{tool}" unless matchers.any? { |matcher| matcher_covers?(matcher, tool) }
  end
end

failures = 0
cases = []

Dir.mktmpdir("monova-lead-guard-worktrees") do |worktrees|
  Dir.mktmpdir("monova-lead-guard-outside") do |outside|
    worktree = File.join(worktrees, "feat-1")
    worktree_env = { "MONOVA_WORKTREES" => worktrees }

    cases = [
      file_tool("Edit an implementation file", "Edit", "app/models/x.rb", 2),
      file_tool("Write a development document", "Write", "docs/development/x.md", 0),
      file_tool("Write an implementation file in a worktree", "Write",
                File.join(worktree, "config/ci.rb"), 2, env: worktree_env),
      file_tool("Write a control file in a worktree", "Write",
                File.join(worktree, "AGENTS.md"), 0, env: worktree_env),
      file_tool("Write a file outside the repository", "Write",
                File.join(outside, "x.rb"), 0),
      file_tool("MultiEdit an implementation file", "MultiEdit", "app/models/x.rb", 2),
      notebook("NotebookEdit an implementation notebook", "app/models/x.ipynb", 2),
      notebook("NotebookEdit a development document", "docs/development/x.ipynb", 0),
      bash("redirect into an implementation path", "echo hi > app/x.rb", 2),
      bash("redirect without a space", "echo hi >app/x.rb", 2),
      bash("append to a dependency file", "cat a >> Gemfile", 2),
      bash("sed -i on an implementation file", "sed -i s/a/b/ config/ci.rb", 2),
      bash("Rails generator", "bin/rails generate model X", 2),
      bash("add a gem", "bundle add rspec-rails", 2),
      bash("git checkout an implementation file", "git checkout -- app/x.rb", 2),
      bash("pipe a gate command", "bin/ci 2>&1 | tail -20", 0),
      bash("redirect stderr of a test command", "bin/rails test 2>/dev/null", 0),
      bash("redirect a read-only command outside the repository",
           "gh pr diff 12 > /tmp/x.diff", 0),
      bash("read an implementation file", "cat config/ci.rb", 0),
      bash("create a branch", "git checkout -b feat/1", 0),
      bash("copy outside the repository before the gate",
           "cp -R a /tmp/x && bin/ci", 0),
      bash("edit outside the repository before the gate",
           "sed -i s/a/b/ /tmp/plan.md; bin/ci", 0),
      bash("copy into an implementation path after a no-op",
           "true && cp x lib/y.rb", 2),
      bash("redirect into an implementation path outside the repository",
           "echo hi > #{File.join(outside, "app/x.rb")}", 0),
      bash("copy a source file to a target outside the repository",
           "cp script/x #{File.join(outside, "y")}", 0),
      bash("copy into an implementation directory with -t", "cp -t lib/ x", 2),
      bash("copy to a bare implementation directory", "cp x lib", 2),
      bash("move an implementation file outside the repository",
           "mv app/x #{File.join(outside, "y")}", 2),
      bash("redirect into a path that leaves and re-enters the repository",
           "echo hi > #{File.join(root, "..", File.basename(root), "app/x.rb")}", 2),
      bash("copy to an implementation file before a redirect",
           "cp x app/y.rb 2>/dev/null", 2),
      bash("copy to an implementation file before an option",
           "cp x app/y.rb -v", 2),
      bash("link into an implementation path before a comment",
           "ln -s x bin/y #note", 2)
    ]

    cases.each do |test_case|
      env = {
        "CLAUDE_PROJECT_DIR" => root,
        "MONOVA_WORKTREES" => nil,
        "XDG_STATE_HOME" => nil
      }.merge(test_case.env)
      output, status = Open3.capture2e(
        env,
        hook,
        stdin_data: payload(test_case.tool, test_case.input),
        chdir: root
      )
      actual = status.exitstatus

      if actual == test_case.expected
        puts "ok: #{test_case.name} (exit #{actual})"
      else
        failures += 1
        warn "lead_guard_canary: #{test_case.name} exited #{actual}, expected #{test_case.expected}"
        warn output unless output.empty?
      end
    end
  end
end

wiring_checks = 0
wiring_failures = 0
settings = File.join(root, ".claude", "settings.json")

wiring_checks += 1
errors = wiring_errors(settings, root)
if errors.empty?
  puts "ok: lead_guard is a PreToolUse command hook for #{WIRING_TOOLS.join("|")}"
else
  wiring_failures += 1
  errors.each { |error| warn "lead_guard_canary: wiring: #{error}" }
end

source_settings = begin
  JSON.parse(File.read(settings))
rescue StandardError
  {}
end

Dir.mktmpdir("monova-lead-guard-settings") do |settings_dir|
  settings_cases = [ [ "an unmodified settings copy passes", source_settings, false ] ]

  without_entry = Marshal.load(Marshal.dump(source_settings))
  Array(without_entry.dig("hooks", "PreToolUse")).each do |entry|
    next unless entry.is_a?(Hash)

    entry["hooks"] = Array(entry["hooks"]).reject do |hook|
      hook.is_a?(Hash) && lead_guard_command?(hook["command"], root)
    end
  end
  settings_cases << [ "a copy without the lead_guard entry fails", without_entry, true ]

  hooks_disabled = Marshal.load(Marshal.dump(source_settings))
  hooks_disabled["disableAllHooks"] = true
  settings_cases << [ "a copy that disables all hooks fails", hooks_disabled, true ]

  WIRING_TOOLS.each do |dropped|
    copy = Marshal.load(Marshal.dump(source_settings))
    Array(copy.dig("hooks", "PreToolUse")).each do |entry|
      next unless entry.is_a?(Hash)
      next unless Array(entry["hooks"]).any? do |hook|
        hook.is_a?(Hash) && lead_guard_command?(hook["command"], root)
      end

      entry["matcher"] = (WIRING_TOOLS - [ dropped ]).join("|")
    end
    settings_cases << [ "a copy whose matcher drops #{dropped} fails", copy, true ]
  end

  echo_lookalike = with_lead_guard_command(
    Marshal.load(Marshal.dump(source_settings)),
    root,
    'echo "$CLAUDE_PROJECT_DIR"/.claude/hooks/lead_guard'
  )
  settings_cases << [ "a copy whose look-alike command only echoes the path fails", echo_lookalike, true ]

  cat_lookalike = with_lead_guard_command(
    Marshal.load(Marshal.dump(source_settings)),
    root,
    'cat "$CLAUDE_PROJECT_DIR"/.claude/hooks/lead_guard'
  )
  settings_cases << [ "a copy whose look-alike command only reads the path fails", cat_lookalike, true ]

  bare_path = with_lead_guard_command(
    Marshal.load(Marshal.dump(source_settings)),
    root,
    ".claude/hooks/lead_guard"
  )
  settings_cases << [ "a copy whose command is the bare script path passes", bare_path, false ]

  settings_cases.each do |name, data, should_fail|
    wiring_checks += 1
    copy_path = File.join(settings_dir, "settings.json")
    File.write(copy_path, JSON.pretty_generate(data))
    copy_errors = wiring_errors(copy_path, root)

    if copy_errors.empty? == !should_fail
      puts "ok: #{name}"
    else
      wiring_failures += 1
      warn "lead_guard_canary: #{name} did not fail as expected"
      copy_errors.each { |error| warn "lead_guard_canary: wiring: #{error}" }
    end
  end
end

total_failures = failures + wiring_failures
if cases.empty? || wiring_checks.zero? || total_failures.positive?
  warn "lead_guard_canary: checked #{cases.length} hook cases and #{wiring_checks} wiring cases; failures=#{total_failures}"
  exit 1
end

puts "lead_guard_canary: checked #{cases.length} hook cases and #{wiring_checks} wiring cases; failures=0"
