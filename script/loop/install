#!/usr/bin/env bash
# Install and enable the Monova loop timer for the current user.
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
UNIT_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
EXPECTED=$HOME/personal/projects/monova/script/loop
STATE=${MONOVA_LOOP_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/monova-loop}

if [[ "$SCRIPT_DIR" != "$EXPECTED" ]]; then
  printf 'warning: the units run %s/driver, not %s\n' \
    "$EXPECTED" "$SCRIPT_DIR" >&2
  printf '         edit script/loop/systemd/monova-loop.service first\n' >&2
fi

mkdir -p -- "$UNIT_DIR"
install -m 0644 -- "$SCRIPT_DIR/systemd/monova-loop.service" "$UNIT_DIR/"
install -m 0644 -- "$SCRIPT_DIR/systemd/monova-loop.timer" "$UNIT_DIR/"

systemctl --user daemon-reload
systemctl --user enable --now monova-loop.timer

if command -v loginctl >/dev/null 2>&1; then
  linger=$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)
  if [[ "$linger" != "yes" ]]; then
    printf 'warning: lingering is off, so the timer stops at logout\n' >&2
    printf '         run: sudo loginctl enable-linger %s\n' "$USER" >&2
  fi
fi

printf 'installed. State: %s\n' "$STATE"
printf 'Stop with: touch %s/STOP\n' "$STATE"
