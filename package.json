{
  "name": "monova",
  "private": true,
  "description": "Lint tooling for the Monova template's Markdown files.",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.20.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\""
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.2"
  }
}
